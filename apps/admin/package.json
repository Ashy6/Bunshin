    "@vitejs/plugin-react": "^5.1.1",
    "echarts": "^6.0.0",
    "hono": "^4.10.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "unpdf": "^2.2.2",
    "vite": "^7.2.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.15.2",
    "@cloudflare/workers-types": "^5.20261125.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
