{
  "$schema":"../../node_modules/wrangler/config-schema.json",
  "name":"ai-bunshin-admin",
  "main":"src/worker.ts",
  "compatibility_date":"2026-11-26",
  "compatibility_flags":["nodejs_compat"],
  "assets":{"directory":"./dist","binding":"ASSETS","not_found_handling":"single-page-application","run_worker_first":["/api/*"]},
  "d1_databases":[{"binding":"DB","database_name":"ai-bunshin-local","database_id":"local-development","migrations_dir":"../../packages/db/migrations"}],
  "r2_buckets":[{"binding":"ASSETS_BUCKET","bucket_name":"ai-bunshin-assets-local"}],
  "vectorize":[{"binding":"VECTORIZE","index_name":"ai-bunshin-knowledge-v1"}],
  "queues":{"producers":[{"binding":"INGESTION_QUEUE","queue":"ai-bunshin-ingestion-local"}],"consumers":[{"queue":"ai-bunshin-ingestion-local","max_batch_size":5,"max_batch_timeout":5,"dead_letter_queue":"ai-bunshin-ingestion-dlq-local"}]},
  "observability":{"enabled":true,"logs":{"enabled":true,"head_sampling_rate":1}}
}
