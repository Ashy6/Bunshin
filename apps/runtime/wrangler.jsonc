{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ai-bunshin-runtime",
  "main": "src/worker.ts",
  "workers_dev": false,
  "compatibility_date": "2026-11-27",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "AI_RUNTIME_ALLOW_ENV_PROVIDER_KEYS": "false"
  },
  "containers": [
    {
      "class_name": "AiRuntimeContainer",
      "scheduling_policy": "default",
      "image": "./Dockerfile",
      "image_build_context": "../..",
      "instance_type": "lite",
      "max_instances": 1,
      "constraints": {
        "regions": ["ENAM", "WNAM"],
        "jurisdiction": "us"
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "AI_RUNTIME",
        "class_name": "AiRuntimeContainer"
      }
    ]
  },
  "exports": {
    "AiRuntimeContainer": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 }
  }
}
