PORT=8790
AI_RUNTIME_AUTH_SECRET=replace-with-at-least-32-random-characters
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
# Environment provider keys are disabled by default. Enable this only during a
# deliberate legacy migration; normal production requests must carry the Key
# encrypted in D1 and covered by the internal HMAC request signature.
AI_RUNTIME_ALLOW_ENV_PROVIDER_KEYS=false
# Optional comma-separated exact HTTPS base URLs (including path) allowed for
# custom providers.
AI_RUNTIME_CUSTOM_BASE_URLS=
AI_RUNTIME_REQUEST_TIMEOUT_MS=60000
